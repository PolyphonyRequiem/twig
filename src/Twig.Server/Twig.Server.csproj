<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Twig.Server</AssemblyName>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Twig.Server</RootNamespace>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bench.Service.Tests" />
    <InternalsVisibleTo Include="Twig.Server.Tests" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <ProjectReference Include="..\Twig\Twig.csproj" />
    <ProjectReference Include="..\Twig.Server.Client\Twig.Server.Client.csproj" />
    <ProjectReference Include="..\Twig.Server.Infrastructure\Twig.Server.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="ServerSourceMetadata" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <ServerSourceRevisionId Condition="'$(ServerSourceRevisionId)' == ''">$(SourceRevisionId)</ServerSourceRevisionId>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="SourceRevision" Value="$(ServerSourceRevisionId)" />
    </ItemGroup>
  </Target>
</Project>
