<Project>

  <!-- Inherit the repo-root Directory.Build.props (TargetFramework, Nullable, etc.). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TwigTestSupportDirectory>$(MSBuildThisFileDirectory)Shared\</TwigTestSupportDirectory>
  </PropertyGroup>

  <!-- IsTestProject is declared in the projects, after this props import. -->
  <Target Name="IncludeTwigTestDiagnostics" BeforeTargets="CoreCompile"
          Condition="'$(IsTestProject)' == 'true'">
    <ItemGroup>
      <Compile Include="$(TwigTestSupportDirectory)TestProgressTrace.cs"
               Link="TestSupport\TestProgressTrace.cs" />
    </ItemGroup>
  </Target>

</Project>
