<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- BenchmarkDotNet needs this to avoid AOT/trim interference -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Spectre.Console.Testing" />
    <!--
      BenchmarkDotNet -> Microsoft.Diagnostics.NETCore.Client pulls
      Microsoft.Extensions.Logging 2.1.1, whose netstandard2.0 assembly defines
      ILoggingBuilder alongside the 11.0.0 one from the shared framework. Under
      the preview.5 SDK (#338) both land in the compile and every generated
      ConsoleAppFramework file fails with CS0433. Pinning the direct reference
      wins over the transitive one and collapses it to a single definition.
      See #342.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Twig\Twig.csproj" />
    <ProjectReference Include="..\..\src\Twig.Domain\Twig.Domain.csproj" />
    <ProjectReference Include="..\..\src\Twig.Infrastructure\Twig.Infrastructure.csproj" />
  </ItemGroup>

</Project>
