<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so consumers are not forced onto a preview SDK (#315).
         net10.0 is GA; net11.0 is what twig itself builds and ships against.
         The blank TargetFramework overrides Directory.Build.props' singular value,
         which MSBuild otherwise prefers, silently making TargetFrameworks a no-op. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>PolyphonyRequiem.Twig.Domain</PackageId>
    <Description>Domain layer for twig — a high-performance .NET CLI for Azure DevOps work-item triage. Pure aggregates, value objects, read models, domain services, and the interfaces the infrastructure layer implements.</Description>
    <PackageTags>azure-devops;ado;work-items;twig;domain</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS0419;CS1580;CS1584</NoWarn>
  </PropertyGroup>

  <!-- The runtime ships UnionAttribute/IUnion natively from .NET 11 (confirmed present in
       System.Private.CoreLib as of SDK 11.0.100-preview.5.26302.115). Compiling the local
       shim there too would be CS0433 "exists in both 'Twig.Domain' and 'System.Runtime'".
       net10.0 still needs it — see Common/CompilerPolyfill.cs. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Common/CompilerPolyfill.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <!-- The union support types are only part of Twig.Domain's public surface on net10.0,
         where CompilerPolyfill.cs is compiled. On net11.0 they come from System.Runtime. -->
    <AdditionalFiles Include="PublicApi/net10.0/PublicAPI.Shipped.txt" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Twig.TestKit" />
    <InternalsVisibleTo Include="Twig.Domain.Tests" />
    <InternalsVisibleTo Include="Twig.Infrastructure" />
    <InternalsVisibleTo Include="Twig.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Twig.Cli.Tests" />
    <InternalsVisibleTo Include="Twig.Tui" />
    <InternalsVisibleTo Include="Twig.Tui.Tests" />
    <InternalsVisibleTo Include="twig" />
    <InternalsVisibleTo Include="Twig.Mcp" />
    <InternalsVisibleTo Include="twig-mcp" />
    <InternalsVisibleTo Include="Twig.Mcp.Tests" />
    <!-- Lets NSubstitute proxy INTERNAL domain interfaces (e.g. IFormLayoutProvider).
         Twig.Infrastructure already carries the same grant for the same reason. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
