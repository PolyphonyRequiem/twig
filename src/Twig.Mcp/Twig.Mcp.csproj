<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>twig-mcp</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Twig.Mcp.Tests" />
    <!-- 🔴 AB#241's byte-identity test lives in Twig.Cli.Tests because that is where the CLI
         surface and its scripted description source already are, and the assertion needs BOTH
         real surfaces in one place. Moving the test to Twig.Mcp.Tests instead would have needed
         the CLI's command, formatter and renderer factories there, which is the larger and more
         invasive direction. -->
    <InternalsVisibleTo Include="Twig.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twig.Domain\Twig.Domain.csproj" />
    <ProjectReference Include="..\Twig.Infrastructure\Twig.Infrastructure.csproj" />
    <!-- 🔴 The agent surface renders the process description with the SAME JsonRenderer the CLI
         uses (AB#241), so the two surfaces' documents are byte-identical by construction rather
         than by two serializers agreeing. Twig.RenderTree is dependency-free and AOT-clean, so
         it does not compromise this project's PublishAot/TrimMode=full settings. -->
    <ProjectReference Include="..\Twig.RenderTree\Twig.RenderTree.csproj" />
  </ItemGroup>

</Project>
