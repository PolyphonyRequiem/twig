<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Versioning -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- Packaging -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.26057.1" />
    <!-- CLI Framework -->
    <PackageVersion Include="ConsoleAppFramework" Version="5.7.13" />
    <!-- SQLite -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.6" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- Markdown -->
    <PackageVersion Include="Markdig" Version="1.1.2" />
    <!-- YAML event parsing only; no reflection-based object deserialization. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Rendering -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- DI -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="11.0.0-rc.3.26522.148" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
  </ItemGroup>
</Project>