<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so consumers are not forced onto a preview SDK (#315).
         net10.0 is GA; net11.0 is what twig itself builds and ships against.
         The blank TargetFramework overrides Directory.Build.props' singular value,
         which MSBuild otherwise prefers, silently making TargetFrameworks a no-op. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>PolyphonyRequiem.Twig.Infrastructure</PackageId>
    <Description>Infrastructure for twig — a high-performance .NET CLI for Azure DevOps work-item triage. SQLite persistence, Azure DevOps REST clients, auth providers, and the AddTwigInfrastructure DI extension.</Description>
    <PackageTags>azure-devops;ado;work-items;twig;sqlite;infrastructure</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS0419;CS1580;CS1584</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- T3 (AB#734) profile-lookup seam. The reference profile is embedded as a
         resource so PublishAot=true / TrimMode=full inline it without a
         filesystem-path fight (see T1 AB#732 §4 "Canonical location").
         The .sha256 sidecar ships beside it per T1 §1 and covers profile.json
         BYTE-EXACT. It is not redundant with the in-band fingerprint.bytes:
         that one is computed over a re-serialized, normalized form (see
         ReferenceProfileFingerprint.ComputeEmbeddedFingerprint), so it is blind
         to raw-byte edits such as role casing or whitespace. The sidecar is the
         only guard that sees them, which is what makes the AB#735 casing
         divergence a build failure rather than a silent release. -->
    <EmbeddedResource Include="Resources\ReferenceProfile\profile.json" />
    <EmbeddedResource Include="Resources\ReferenceProfile\profile.json.sha256" />
  </ItemGroup>

  <!-- T1 §1: "the .sha256 is computed at build time and covers profile.json
       byte-exact". The sidecar is committed so a profile change stays a
       reviewable diff of two human-readable files; the build's job is to
       guarantee the two agree, so a profile edit that forgets the sidecar
       fails here instead of at a user's first command. -->
  <Target Name="VerifyReferenceProfileChecksum"
          BeforeTargets="BeforeBuild"
          Inputs="Resources\ReferenceProfile\profile.json;Resources\ReferenceProfile\profile.json.sha256"
          Outputs="$(IntermediateOutputPath)referenceprofile.checksum.stamp">
    <GetFileHash Files="Resources\ReferenceProfile\profile.json" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_ReferenceProfileActualHash" />
    </GetFileHash>
    <ReadLinesFromFile File="Resources\ReferenceProfile\profile.json.sha256">
      <Output TaskParameter="Lines" ItemName="_ReferenceProfileSidecarLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_ReferenceProfileExpectedHash>@(_ReferenceProfileSidecarLines)</_ReferenceProfileExpectedHash>
      <_ReferenceProfileActualHash>$(_ReferenceProfileActualHash.ToLowerInvariant())</_ReferenceProfileActualHash>
      <_ReferenceProfileExpectedHash>$(_ReferenceProfileExpectedHash.Trim().ToLowerInvariant())</_ReferenceProfileExpectedHash>
    </PropertyGroup>
    <Error Condition="'$(_ReferenceProfileActualHash)' != '$(_ReferenceProfileExpectedHash)'"
           Text="Reference profile checksum drift: Resources\ReferenceProfile\profile.json hashes to $(_ReferenceProfileActualHash) but profile.json.sha256 pins $(_ReferenceProfileExpectedHash). Update the sidecar to the actual hash (T1 AB#732 §1)." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)referenceprofile.checksum.stamp" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twig.Domain\Twig.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Twig.Infrastructure.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Twig</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Twig.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>twig-mcp</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Twig.Mcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
